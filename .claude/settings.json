{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git add settings.json:*)",
      "Bash(git add ./settings.json:*)",
      "Bash(git add -f settings.json:*)",
      "Bash(git add ~/.claude/settings.json:*)",
      "Bash(git commit settings.json:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git commit -am:*)",
      "Bash(git commit -ma:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run -i --silent ~/.claude/scripts/typescript/protect-root-settings.ts"
          }
        ]
      }
    ]
  }
}
